<resources>
    <!--
        On API 31+ the system splash screen is configured by
        androidx.core:core-splashscreen (Theme.SplashScreen), which reads the
        windowSplashScreen* attributes itself. Nothing extra is needed here, and
        the app theme must keep the transparent system bars so edge-to-edge
        still works, so this file intentionally defines no Theme.FarmOs override.
    -->
</resources>
